// ───────────────────────────── TYPES ─────────────────────────────
type OB
    box bx
    float top
    float bot
    int dir
    int state
    string kind
    bool tapped = false

type FVG
    box bx
    float top
    float bot
    float ftop
    float fbot
    int dir
    int state

type Liq
    line ln
    label lb
    box pool
    float price
    int idx
    bool isHigh

type Lvl
    line ln
    label lb
    float price
    bool isRes
    bool flipped

type SD
    box bx
    float top
    float bot
    int dir

type Sess
    string name
    bool active = false
    float hi
    float lo
    int startIdx
    box bx
    line hiLn
    line loLn
    label hiLb
    label loLb
    bool hiSwept = false
    bool loSwept = false

type KL
    line ln
    label lb

// ───────────────────────────── BASE SERIES ─────────────────────────────
atr = ta.atr(14)
body = math.abs(close - open)
rng  = high - low
isDispUp = close > open and body >= atr * dispMult and rng > 0 and body / rng >= 0.6
isDispDn = close < open and body >= atr * dispMult and rng > 0 and body / rng >= 0.6

// ───────────────────────────── FUNCTIONS ─────────────────────────────
f_isStopHunt(bool isHigh, float lvl) =>
    float rngC = math.max(high - low, syminfo.mintick)
    float wickC = isHigh ? high - math.max(open, close) : math.min(open, close) - low
    float pen = isHigh ? high - lvl : lvl - low
    (wickC / rngC >= 0.5) and (pen >= atr * shPen) and (isHigh ? close < open : close > open)

f_sweep(bool isHigh, float lvl, string nm) =>
    bool hunt = f_isStopHunt(isHigh, lvl)
    float y = isHigh ? high : low
    if hunt and showStopHunt
        label.new(bar_index, y, "Stop Hunt\n" + nm, style=isHigh ? label.style_label_down : label.style_label_up, color=color.new(cHunt, 15), textcolor=color.white, size=size.small)
    else if showSweep
        label.new(bar_index, y, "Sweep " + nm, style=isHigh ? label.style_label_down : label.style_label_up, color=color.new(cSweep, 25), textcolor=color.white, size=size.small)
    hunt

f_col(int dir) => dir == 1 ? cBullOB : cBearOB

f_txt(int dir, int state, string kind) =>
    string d = dir == 1 ? "Bull" : "Bear"
    string od = dir == 1 ? "Bear" : "Bull"
    string t = kind == "RB" ? d + " Rejection Blk" : state == 1 ? od + " Breaker Blk" : state == 2 ? "Reclaimed " + d + " OB" : kind == "MB" ? d + " Mitigation Blk" : d + " OB"
    t

f_ob_off(int fromIdx, bool lowest) =>
    int n = math.min(bar_index - fromIdx, 400)
    float ext = lowest ? 1e18 : -1e18
    int off = 0
    for i = 0 to n
        float v = lowest ? low[i] : high[i]
        if (lowest and v < ext) or (not lowest and v > ext)
            ext := v
            off := i
    off

f_new_ob(array<OB> arr, int dir, int off, string kind, int maxN) =>
    float t = high[off]
    float b = low[off]
    bool dup = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            OB o = arr.get(i)
            if o.dir == dir and o.state == 0 and t >= o.bot and b <= o.top
                dup := true
    if not dup
        color c = kind == "RB" ? cRB : f_col(dir)
        box bx = box.new(bar_index - off, t, bar_index, b, border_color=color.new(c, 30), bgcolor=c, extend=extend.right, text=f_txt(dir, 0, kind), text_size=size.small, text_color=color.new(c, 0), text_halign=text.align_right)
        arr.push(OB.new(bx, t, b, dir, 0, kind))
        if arr.size() > maxN
            OB old = arr.shift()
            box.delete(old.bx)
    dup

f_new_rb(array<OB> arr, int dir, int x, float bot, float top) =>
    box bx = box.new(x, top, bar_index, bot, border_color=color.new(cRB, 30), bgcolor=cRB, extend=extend.right, text=f_txt(dir, 0, "RB"), text_size=size.small, text_color=color.new(cRB, 0), text_halign=text.align_right)
    arr.push(OB.new(bx, top, bot, dir, 0, "RB"))
    if arr.size() > maxRB
        OB old = arr.shift()
        box.delete(old.bx)
    true

f_upd_blocks(array<OB> arr) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            OB o = arr.get(i)
            bool bullOrig = o.dir == 1
            bool invalid = bullOrig ? close < o.bot : close > o.top
            if o.state == 0
                if invalid
                    if o.kind == "RB" or not showBreaker
                        box.delete(o.bx)
                        arr.remove(i)
                    else
                        o.state := 1
                        color c2 = f_col(-o.dir)
                        box.set_bgcolor(o.bx, c2)
                        box.set_border_color(o.bx, color.new(c2, 30))
                        box.set_text(o.bx, f_txt(o.dir, 1, o.kind))
                        box.set_text_color(o.bx, color.new(c2, 0))
                else if not o.tapped and (bullOrig ? low <= o.top : high >= o.bot)
                    o.tapped := true
                    color c1 = o.kind == "RB" ? cRB : f_col(o.dir)
                    box.set_bgcolor(o.bx, color.new(c1, 93))
            else if o.state == 1
                bool reclaim = bullOrig ? close > o.top : close < o.bot
                if reclaim
                    if showReclaimed
                        o.state := 2
                        color c3 = f_col(o.dir)
                        box.set_bgcolor(o.bx, c3)
                        box.set_border_color(o.bx, color.new(c3, 30))
                        box.set_text(o.bx, f_txt(o.dir, 2, o.kind))
                        box.set_text_color(o.bx, color.new(c3, 0))
                    else
                        box.delete(o.bx)
                        arr.remove(i)
            else
                if invalid
                    box.delete(o.bx)
                    arr.remove(i)
    true

f_new_fvg(array<FVG> arr, int dir, float t, float b) =>
    color c = dir == 1 ? cFvgBull : cFvgBear
    box bx = box.new(bar_index - 2, t, bar_index, b, border_color=color.new(c, 40), bgcolor=c, extend=extend.right, text=dir == 1 ? "Bull FVG" : "Bear FVG", text_size=size.tiny, text_color=color.new(c, 0), text_halign=text.align_right)
    arr.push(FVG.new(bx, t, b, t, b, dir, 0))
    if arr.size() > fvgMax
        FVG old = arr.shift()
        box.delete(old.bx)
    true

f_upd_fvg(array<FVG> arr) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            FVG g = arr.get(i)
            bool bull = g.dir == 1
            if g.state == 0
                bool broke = bull ? close < g.bot : close > g.top
                if broke
                    if showIFVG
                        g.state := 1
                        box.set_top(g.bx, g.ftop)
                        box.set_bottom(g.bx, g.fbot)
                        box.set_bgcolor(g.bx, cIFVG)
                        box.set_border_color(g.bx, color.new(cIFVG, 20))
                        box.set_border_style(g.bx, line.style_dotted)
                        box.set_text(g.bx, bull ? "Bear IFVG" : "Bull IFVG")
                        box.set_text_color(g.bx, color.new(cIFVG, 0))
                    else
                        box.delete(g.bx)
                        arr.remove(i)
                else
                    if bull
                        if low < g.top
                            g.top := math.max(low, g.bot)
                            box.set_top(g.bx, g.top)
                    else
                        if high > g.bot
                            g.bot := math.min(high, g.top)
                            box.set_bottom(g.bx, g.bot)
                    if g.top <= g.bot
                        box.delete(g.bx)
                        arr.remove(i)
            else
                bool back = bull ? close > g.ftop : close < g.fbot
                if back
                    box.delete(g.bx)
                    arr.remove(i)
    true

f_add_liq(array<Liq> arr, bool isHigh, float price, int idx) =>
    bool merged = false
    if showPools and arr.size() > 0
        for i = 0 to arr.size() - 1
            Liq l = arr.get(i)
            if not merged and math.abs(l.price - price) <= atr * eqTol
                merged := true
                float newP = isHigh ? math.max(l.price, price) : math.min(l.price, price)
                float zHi = math.max(l.price, price) + atr * 0.03
                float zLo = math.min(l.price, price) - atr * 0.03
                l.price := newP
                line.set_y1(l.ln, newP)
                line.set_y2(l.ln, newP)
                if na(l.pool)
                    l.pool := box.new(l.idx, zHi, bar_index, zLo, border_color=color.new(cPool, 30), bgcolor=cPool, extend=extend.right, text=isHigh ? "EQH Liquidity Pool" : "EQL Liquidity Pool", text_size=size.tiny, text_color=color.new(cPool, 0), text_halign=text.align_right)
                else
                    box.set_top(l.pool, math.max(box.get_top(l.pool), zHi))
                    box.set_bottom(l.pool, math.min(box.get_bottom(l.pool), zLo))
                label.set_text(l.lb, isHigh ? "BSL (EQH)" : "SSL (EQL)")
    if not merged
        color c = isHigh ? cBSL : cSSL
        line ln = line.new(idx, price, bar_index, price, extend=extend.right, color=c, style=line.style_dashed)
        label lb = label.new(bar_index, price, isHigh ? "BSL" : "SSL", style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.tiny)
        arr.push(Liq.new(ln, lb, box(na), price, idx, isHigh))
        if arr.size() > liqMax
            Liq old = arr.shift()
            line.delete(old.ln)
            label.delete(old.lb)
            box.delete(old.pool)
    merged

f_upd_liq(array<Liq> arr, bool isHigh) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Liq l = arr.get(i)
            bool pierced = isHigh ? high > l.price : low < l.price
            if pierced
                bool closedBack = isHigh ? close < l.price : close > l.price
                if closedBack and (showSweep or showStopHunt)
                    f_sweep(isHigh, l.price, isHigh ? "BSL" : "SSL")
                line.set_extend(l.ln, extend.none)
                line.set_x2(l.ln, bar_index)
                if not na(l.pool)
                    box.set_extend(l.pool, extend.none)
                    box.set_right(l.pool, bar_index)
                label.delete(l.lb)
                arr.remove(i)
    true

f_add_sr(array<Lvl> arr, bool isRes, float price, int idx) =>
    bool dup = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Lvl v = arr.get(i)
            if v.isRes == isRes and math.abs(v.price - price) <= atr * 0.25
                dup := true
    if not dup
        color c = isRes ? cRes : cSup
        line ln = line.new(idx, price, bar_index, price, extend=extend.right, color=c, width=2)
        label lb = label.new(bar_index, price, isRes ? "Resistance" : "Support", style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.tiny)
        arr.push(Lvl.new(ln, lb, price, isRes, false))
        if arr.size() > srMax
            Lvl old = arr.shift()
            line.delete(old.ln)
            label.delete(old.lb)
    dup

f_upd_sr(array<Lvl> arr) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            Lvl v = arr.get(i)
            bool broke = v.isRes ? close > v.price : close < v.price
            if broke
                if not v.flipped and showFlip
                    v.flipped := true
                    v.isRes := not v.isRes
                    color c = v.isRes ? cRes : cSup
                    line.set_color(v.ln, c)
                    label.set_text(v.lb, v.isRes ? "Resistance (flip)" : "Support (flip)")
                    label.set_textcolor(v.lb, c)
                else
                    line.set_extend(v.ln, extend.none)
                    line.set_x2(v.ln, bar_index)
                    label.delete(v.lb)
                    arr.remove(i)
    true

f_new_sd(array<SD> arr, int dir, int lft, float t, float b) =>
    bool dup = false
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            SD z = arr.get(i)
            if z.dir == dir and t >= z.bot and b <= z.top
                dup := true
    if not dup
        color c = dir == 1 ? cDemand : cSupply
        box bx = box.new(lft, t, bar_index, b, border_color=color.new(c, 30), bgcolor=c, extend=extend.right, text=dir == 1 ? "Demand Zone" : "Supply Zone", text_size=size.small, text_color=color.new(c, 0), text_halign=text.align_right)
        arr.push(SD.new(bx, t, b, dir))
        if arr.size() > sdMax
            SD old = arr.shift()
            box.delete(old.bx)
    dup

f_upd_sd(array<SD> arr) =>
    if arr.size() > 0
        for i = arr.size() - 1 to 0
            SD z = arr.get(i)
            bool dead = z.dir == 1 ? close < z.bot : close > z.top
            if dead
                box.delete(z.bx)
                arr.remove(i)
    true

f_struct(bool bull, int x1, float lvl, string txt, color c, bool dashed) =>
    line.new(x1, lvl, bar_index, lvl, color=c, style=dashed ? line.style_dashed : line.style_dotted, width=1)
    label.new(math.round(math.avg(x1, bar_index)), lvl, txt, style=bull ? label.style_label_down : label.style_label_up, color=color.new(c, 100), textcolor=c, size=size.small)
    true

f_sess(Sess s, bool inS, bool show, color c) =>
    if show
        if inS
            if not s.active
                s.active := true
                s.hi := high
                s.lo := low
                s.startIdx := bar_index
                line.delete(s.hiLn)
                line.delete(s.loLn)
                label.delete(s.hiLb)
                label.delete(s.loLb)
                box.delete(s.bx)
                s.hiSwept := false
                s.loSwept := false
                s.bx := box.new(bar_index, high, bar_index, low, border_color=color.new(c, 40), bgcolor=color.new(c, 92), text=s.name, text_size=size.tiny, text_color=c, text_halign=text.align_left, text_valign=text.align_top)
            else
                s.hi := math.max(s.hi, high)
                s.lo := math.min(s.lo, low)
                box.set_top(s.bx, s.hi)
                box.set_bottom(s.bx, s.lo)
                box.set_right(s.bx, bar_index)
        else if s.active
            s.active := false
            s.hiLn := line.new(s.startIdx, s.hi, bar_index, s.hi, extend=extend.right, color=c, style=line.style_dashed)
            s.loLn := line.new(s.startIdx, s.lo, bar_index, s.lo, extend=extend.right, color=c, style=line.style_dashed)
            s.hiLb := label.new(bar_index, s.hi, s.name + " High (BSL)", style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.tiny)
            s.loLb := label.new(bar_index, s.lo, s.name + " Low (SSL)", style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.tiny)
        if not s.active and not na(s.hiLn)
            if not s.hiSwept and high > s.hi
                s.hiSwept := true
                if close < s.hi
                    f_sweep(true, s.hi, s.name + " High")
                line.set_extend(s.hiLn, extend.none)
                line.set_x2(s.hiLn, bar_index)
                label.delete(s.hiLb)
            if not s.loSwept and low < s.lo
                s.loSwept := true
                if close > s.lo
                    f_sweep(false, s.lo, s.name + " Low")
                line.set_extend(s.loLn, extend.none)
                line.set_x2(s.loLn, bar_index)
                label.delete(s.loLb)
    true

f_move_sess(Sess s) =>
    if not na(s.hiLb) and not s.hiSwept
        label.set_x(s.hiLb, bar_index + 3)
    if not na(s.loLb) and not s.loSwept
        label.set_x(s.loLb, bar_index + 3)
    true

f_kl_set(KL k, float y, string txt, color c, bool ext) =>
    line.delete(k.ln)
    label.delete(k.lb)
    k.ln := line.new(bar_index, y, bar_index + 1, y, extend=ext ? extend.right : extend.none, color=c, style=ext ? line.style_solid : line.style_dotted, width=1)
    k.lb := label.new(bar_index, y, txt, style=label.style_label_left, color=color.new(c, 100), textcolor=c, size=size.tiny)
    true

f_kl_move(KL k) =>
    if not na(k.ln)
        label.set_xy(k.lb, bar_index + 3, line.get_y1(k.ln))
    true

f_chk(float lvl, bool isHigh, string nm) =>
    if not na(lvl)
        bool hit = isHigh ? (high > lvl and close < lvl and high[1] <= lvl) : (low < lvl and close > lvl and low[1] >= lvl)
        if hit
            f_sweep(isHigh, lvl, nm)
    true

// ───────────────────────────── STATE ─────────────────────────────
var array<OB>  obs  = array.new<OB>()
var array<OB>  rbs  = array.new<OB>()
var array<FVG> fvgs = array.new<FVG>()
var array<Liq> bsl  = array.new<Liq>()
var array<Liq> ssl  = array.new<Liq>()
var array<Lvl> srs  = array.new<Lvl>()
var array<SD>  sds  = array.new<SD>()

var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na
var int lastSHi = na
var int lastSLi = na
var bool shBroken = true
var bool slBroken = true
var int trend = 0

// ───────────────────────────── UPDATE EXISTING OBJECTS ─────────────────────────────
f_upd_blocks(obs)
f_upd_blocks(rbs)
f_upd_fvg(fvgs)
f_upd_liq(bsl, true)
f_upd_liq(ssl, false)
f_upd_sr(srs)
f_upd_sd(sds)

// ───────────────────────────── SWINGS ─────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

if not na(ph)
    prevSH := lastSH
    lastSH := ph
    lastSHi := bar_index - swingLen
    shBroken := false
    if showSwings
        string t = classify ? (na(prevSH) ? "SH" : (ph > prevSH ? "HH" : "LH")) : "SH"
        color c = t == "HH" ? cHH : t == "LH" ? cLL : cEQ
        label.new(lastSHi, ph, t, style=label.style_label_down, color=color.new(c, 100), textcolor=c, size=size.small, tooltip="Swing High")
    if showLiq
        f_add_liq(bsl, true, ph, lastSHi)
    if showRB
        float o_ = open[swingLen]
        float c_ = close[swingLen]
        float h_ = high[swingLen]
        float l_ = low[swingLen]
        float wick = h_ - math.max(o_, c_)
        if (h_ - l_) > 0 and wick / (h_ - l_) >= rbRatio and wick >= atr * 0.3
            f_new_rb(rbs, -1, lastSHi, math.max(o_, c_), h_)

if not na(pl)
    prevSL := lastSL
    lastSL := pl
    lastSLi := bar_index - swingLen
    slBroken := false
    if showSwings
        string t = classify ? (na(prevSL) ? "SL" : (pl < prevSL ? "LL" : "HL")) : "SL"
        color c = t == "HL" ? cHH : t == "LL" ? cLL : cEQ
        label.new(lastSLi, pl, t, style=label.style_label_up, color=color.new(c, 100), textcolor=c, size=size.small, tooltip="Swing Low")
    if showLiq
        f_add_liq(ssl, false, pl, lastSLi)
    if showRB
        float o_ = open[swingLen]
        float c_ = close[swingLen]
        float h_ = high[swingLen]
        float l_ = low[swingLen]
        float wick = math.min(o_, c_) - l_
        if (h_ - l_) > 0 and wick / (h_ - l_) >= rbRatio and wick >= atr * 0.3
            f_new_rb(rbs, 1, lastSLi, l_, math.min(o_, c_))

// ───────────────────────────── STRUCTURE: BOS / CHoCH / MSS ─────────────────────────────
bool bullBreak = not na(lastSH) and not shBroken and close > lastSH
bool bearBreak = not na(lastSL) and not slBroken and close < lastSL
bool bullChoch = bullBreak and trend == -1
bool bearChoch = bearBreak and trend == 1
bool bullMSS = bullChoch and (isDispUp or isDispUp[1] or isDispUp[2])
bool bearMSS = bearChoch and (isDispDn or isDispDn[1] or isDispDn[2])
bool bullBos = bullBreak and not bullChoch
bool bearBos = bearBreak and not bearChoch

if bullBreak
    if bullChoch
        if showCHOCH
            f_struct(true, lastSHi, lastSH, "CHoCH", cCHOCH, false)
    else
        if showBOS
            f_struct(true, lastSHi, lastSH, "BOS", cBOS, true)
    if bullMSS and showMSS
        label.new(bar_index, low, "Bullish MSS", style=label.style_label_up, color=color.new(cMSS, 15), textcolor=color.white, size=size.small)
    if showOB
        int off = f_ob_off(lastSHi, true)
        f_new_ob(obs, 1, off, bullChoch and showMit ? "MB" : "OB", maxOB)
    shBroken := true
    trend := 1

if bearBreak
    if bearChoch
        if showCHOCH
            f_struct(false, lastSLi, lastSL, "CHoCH", cCHOCH, false)
    else
        if showBOS
            f_struct(false, lastSLi, lastSL, "BOS", cBOS, true)
    if bearMSS and showMSS
        label.new(bar_index, high, "Bearish MSS", style=label.style_label_down, color=color.new(cMSS, 15), textcolor=color.white, size=size.small)
    if showOB
        int off = f_ob_off(lastSLi, false)
        f_new_ob(obs, -1, off, bearChoch and showMit ? "MB" : "OB", maxOB)
    slBroken := true
    trend := -1

// ───────────────────────────── INDUCEMENT (IDM) ─────────────────────────────
iph = ta.pivothigh(high, idmLen, idmLen)
ipl = ta.pivotlow(low, idmLen, idmLen)
var line idmLn = na
var label idmLb = na
var float idmP = na
var int idmDir = 0

if showIDM
    if (bullBreak or bearBreak) and not na(idmP)
        line.delete(idmLn)
        label.delete(idmLb)
        idmP := na
    if na(idmP)
        if trend == 1 and not na(ipl) and not na(lastSHi) and (bar_index - idmLen) > lastSHi
            idmP := ipl
            idmDir := 1
            idmLn := line.new(bar_index - idmLen, ipl, bar_index, ipl, color=cIDM, style=line.style_dotted)
            idmLb := label.new(bar_index - idmLen, ipl, "IDM", style=label.style_label_up, color=color.new(cIDM, 100), textcolor=cIDM, size=size.small, tooltip="Inducement")
        else if trend == -1 and not na(iph) and not na(lastSLi) and (bar_index - idmLen) > lastSLi
            idmP := iph
            idmDir := -1
            idmLn := line.new(bar_index - idmLen, iph, bar_index, iph, color=cIDM, style=line.style_dotted)
            idmLb := label.new(bar_index - idmLen, iph, "IDM", style=label.style_label_down, color=color.new(cIDM, 100), textcolor=cIDM, size=size.small, tooltip="Inducement")
    else
        bool taken = idmDir == 1 ? low < idmP : high > idmP
        line.set_x2(idmLn, bar_index)
        if taken
            label.set_text(idmLb, "IDM taken")
            idmP := na

// ───────────────────────────── FAIR VALUE GAPS ─────────────────────────────
bool bullFVG = low > high[2] and (low - high[2]) >= atr * fvgMinATR
bool bearFVG = high < low[2] and (low[2] - high) >= atr * fvgMinATR
if showFVG
    if bullFVG
        f_new_fvg(fvgs, 1, low, high[2])
    if bearFVG
        f_new_fvg(fvgs, -1, low[2], high)

// ───────────────────────────── SUPPLY / DEMAND ─────────────────────────────
bool base1 = math.abs(close[1] - open[1]) <= atr * 0.6
bool base2 = math.abs(close[2] - open[2]) <= atr * 0.6
if showSD and base1
    int lftSD = base2 ? bar_index - 2 : bar_index - 1
    float zTop = base2 ? math.max(high[1], high[2]) : high[1]
    float zBot = base2 ? math.min(low[1], low[2]) : low[1]
    if isDispUp
        f_new_sd(sds, 1, lftSD, zTop, zBot)
    if isDispDn
        f_new_sd(sds, -1, lftSD, zTop, zBot)

// ───────────────────────────── SUPPORT / RESISTANCE ─────────────────────────────
srH = ta.pivothigh(high, srLen, srLen)
srL = ta.pivotlow(low, srLen, srLen)
if showSR
    if not na(srH)
        f_add_sr(srs, true, srH, bar_index - srLen)
    if not na(srL)
        f_add_sr(srs, false, srL, bar_index - srLen)

// ───────────────────────────── TRADING RANGE ─────────────────────────────
float hhR = ta.highest(high, rangeLen)
float llR = ta.lowest(low, rangeLen)
var box rangeBx = na
var bool inRange = false
var float rTop = na
var float rBot = na
if showRange
    if not inRange and (hhR - llR) <= atr * rangeATR
        inRange := true
        rTop := hhR
        rBot := llR
        rangeBx := box.new(bar_index - rangeLen + 1, rTop, bar_index, rBot, border_color=color.new(cEQ, 50), bgcolor=cRange, text="Trading Range", text_size=size.tiny, text_color=cEQ, text_halign=text.align_center)
    else if inRange
        if close > rTop or close < rBot
            inRange := false
        else
            box.set_right(rangeBx, bar_index)

// ───────────────────────────── SESSIONS ─────────────────────────────
bool intra = timeframe.isintraday
bool inAsia = not na(time(timeframe.period, sAsia, tz))
bool inLon  = not na(time(timeframe.period, sLon, tz))
bool inNY   = not na(time(timeframe.period, sNY, tz))
var Sess asia = Sess.new("Asia")
var Sess lon  = Sess.new("London")
var Sess nyk  = Sess.new("New York")
f_sess(asia, inAsia, showAsia and intra, cAsia)
f_sess(lon, inLon, showLon and intra, cLon)
f_sess(nyk, inNY, showNY and intra, cNY)

// ───────────────────────────── DAILY / WEEKLY LEVELS ─────────────────────────────
bool newD = timeframe.change("D") or barstate.isfirst
bool newW = timeframe.change("W") or barstate.isfirst
var float dHi = na
var float dLo = na
var float wHi = na
var float wLo = na
var float pdh = na
var float pdl = na
var float pwh = na
var float pwl = na
var int dStart = na
var int wStart = na
var KL pdhK = KL.new()
var KL pdlK = KL.new()
var KL pwhK = KL.new()
var KL pwlK = KL.new()
var KL dhK  = KL.new()
var KL dlK  = KL.new()
var KL whK  = KL.new()
var KL wlK  = KL.new()

if newD
    pdh := dHi
    pdl := dLo
    dHi := high
    dLo := low
    dStart := bar_index
    if showPDHL and not na(pdh)
        f_kl_set(pdhK, pdh, "PDH", cPD, true)
        f_kl_set(pdlK, pdl, "PDL", cPD, true)
    if showDWHL
        f_kl_set(dhK, dHi, "Daily High", cDW, false)
        f_kl_set(dlK, dLo, "Daily Low", cDW, false)
else
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)

if newW
    pwh := wHi
    pwl := wLo
    wHi := high
    wLo := low
    wStart := bar_index
    if showPWHL and not na(pwh)
        f_kl_set(pwhK, pwh, "PWH", color.new(cPD, 25), true)
        f_kl_set(pwlK, pwl, "PWL", color.new(cPD, 25), true)
    if showDWHL
        f_kl_set(whK, wHi, "Weekly High", cDW, false)
        f_kl_set(wlK, wLo, "Weekly Low", cDW, false)
else
    wHi := math.max(wHi, high)
    wLo := math.min(wLo, low)

if showDWHL
    if not na(dhK.ln)
        line.set_xy1(dhK.ln, dStart, dHi)
        line.set_xy2(dhK.ln, bar_index, dHi)
        line.set_xy1(dlK.ln, dStart, dLo)
        line.set_xy2(dlK.ln, bar_index, dLo)
    if not na(whK.ln)
        line.set_xy1(whK.ln, wStart, wHi)
        line.set_xy2(whK.ln, bar_index, wHi)
        line.set_xy1(wlK.ln, wStart, wLo)
        line.set_xy2(wlK.ln, bar_index, wLo)

if showSweep or showStopHunt
    if showPDHL
        f_chk(pdh, true, "PDH")
        f_chk(pdl, false, "PDL")
    if showPWHL
        f_chk(pwh, true, "PWH")
        f_chk(pwl, false, "PWL")

// ───────────────────────────── LAST-BAR DRAWINGS ─────────────────────────────
// ───────────────────────────── SIGNALS: confluence score, SL / TP, backtest ─────────────────────────────
type Trd
    line lE
    line lS
    line lT1
    line lT2

f_bias() =>
    float e1 = ta.ema(close, 21)
    float e2 = ta.ema(close, 50)
    float r = ta.rsi(close, 14)
    (e1 > e2 and close > e1 and r > 50) ? 1 : (e1 < e2 and close < e1 and r < 50) ? -1 : 0

f_zoneHit(array<OB> oa, array<FVG> fa, bool bull) =>
    bool hit = false
    int want = bull ? 1 : -1
    if oa.size() > 0
        for i = 0 to oa.size() - 1
            OB o = oa.get(i)
            int eff = o.state == 1 ? -o.dir : o.dir
            if eff == want and low <= o.top and high >= o.bot
                hit := true
    if fa.size() > 0
        for i = 0 to fa.size() - 1
            FVG g = fa.get(i)
            int eff = g.state == 1 ? -g.dir : g.dir
            if eff == want and low <= g.top and high >= g.bot
                hit := true
    hit

f_draw_trade(Trd t, int dir, float e, float s, float t1, float t2, int conf) =>
    string en = str.tostring(e, format.mintick)
    string ss = str.tostring(s, format.mintick)
    string st1 = str.tostring(t1, format.mintick)
    string st2 = str.tostring(t2, format.mintick)
    color cc = dir == 1 ? #00c853 : #ff1744
    t.lE := line.new(bar_index, e, bar_index + 1, e, color=#2196f3, width=2)
    t.lS := line.new(bar_index, s, bar_index + 1, s, color=#ff1744, width=2)
    t.lT1 := line.new(bar_index, t1, bar_index + 1, t1, color=#00c853, width=2)
    t.lT2 := line.new(bar_index, t2, bar_index + 1, t2, color=#00c853, width=1, style=line.style_dotted)
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "BUY " : "SELL ") + str.tostring(conf) + "%", style=dir == 1 ? label.style_label_up : label.style_label_down, color=cc, textcolor=color.white, size=size.normal, tooltip="Entry " + en + "\nSL " + ss + "\nTP1 " + st1 + "\nTP2 " + st2 + "\nConfidence " + str.tostring(conf) + "%")
    label.new(bar_index + 1, e, "Entry " + en, style=label.style_label_left, color=color.new(#2196f3, 100), textcolor=#2196f3, size=size.tiny)
    label.new(bar_index + 1, s, "SL " + ss, style=label.style_label_left, color=color.new(#ff1744, 100), textcolor=#ff1744, size=size.tiny)
    label.new(bar_index + 1, t1, "TP1 " + st1, style=label.style_label_left, color=color.new(#00c853, 100), textcolor=#00c853, size=size.tiny)
    label.new(bar_index + 1, t2, "TP2 " + st2, style=label.style_label_left, color=color.new(#00c853, 100), textcolor=#00c853, size=size.tiny)
    true

int htfBias = request.security(syminfo.tickerid, htfTF, f_bias())
float lowN = ta.lowest(low, 10)[1]
float highN = ta.highest(high, 10)[1]
float low5 = ta.lowest(low, 5)
float high5 = ta.highest